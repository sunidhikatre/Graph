class Pair {
    int node;
    int weight;
    Pair(int node, int weight) {
        this.node = node;
        this.weight = weight;
    }
}
class Solution {
    static int spanningTree(int V, int E, List<List<int[]>> adj) {
        PriorityQueue<Pair> pq = new PriorityQueue<>((a,b) -> a.weight - b.weight);
        pq.add(new Pair(0,0));
        int[] visited = new int[V];
        int sum = 0;
        
        while(!pq.isEmpty()) {
            Pair curr = pq.poll();
            int currentNode = curr.node;
            int currentWeight = curr.weight;
            
            if(visited[currentNode] == 1) {
                continue;
            }
            
            visited[currentNode] = 1;
            sum += currentWeight;
            for(int[] adjNode : adj.get(currentNode)) {
                int v = adjNode[0];
                int w = adjNode[1];
                if(visited[v] == 0) {
                    pq.add(new Pair(v,w));
                }
            }
        }
        return sum;
    }
}
