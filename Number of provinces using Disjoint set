class Solution {

    public int findCircleNum(int[][] isConnected) {

       int n = isConnected.length;
       int[] parent = new int[n];
       int[] size = new int[n];
       int cnt = 0;
     
        for(int i = 0; i < n; i++) {
            parent[i] = i;
            size[i] = 1;  
        }

        for(int i = 0; i < n; i++) {
            for(int j = i + 1; j < n; j++) {
                if(isConnected[i][j] == 1) {
                    union(i, j, parent, size);
                }
            }
        }

        for(int i = 0; i < n; i++) {
            if(parent[i] == i) {
                cnt++;
            }
        }
        return cnt;

    }

    private int find(int i, int[] parent) {
        if(i != parent[i]) {
            parent[i] = find(parent[i], parent);
        }
        return parent[i];
    }

    private void union(int p, int q, int[] parent, int[] size) {
        int parentP = find(p, parent);
        int parentQ = find(q, parent);

        if(parentP == parentQ) {
          return;
        } 

       if(size[parentP] >= size[parentQ]) {
            parent[parentQ] = parentP; // chote wale ke utilmate parent ka parent now will be bigger one
            size[parentP] = size[parentP] + size[parentQ];
       } else {   
            parent[parentP] = parentQ;
            size[parentQ] = size[parentP] + size[parentQ];     
       }
    }



}
